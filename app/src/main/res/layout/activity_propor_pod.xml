<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conteudoPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eq_fundo">

        <!-- Barra do topo -->
        <LinearLayout
            android:id="@+id/barraTopo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_barra_escura"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnVoltar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Voltar"
                android:padding="6dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="SERV+"
                android:textColor="@color/branco"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Menu"
                android:padding="6dp"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barraTopo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Propor um skill pod"
                    android:textColor="@color/eq_escuro"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sua ideia vai para análise. Se um administrador aprovar, o pod entra no catálogo para todo mundo."
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <!-- Nome -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Nome do pod"
                    android:textColor="@color/eq_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_busca"
                    android:hint="Ex.: Pod Fotografia de eventos"
                    android:inputType="textCapSentences"
                    android:maxLength="40"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/eq_escuro"
                    android:textColorHint="@color/eq_texto_claro"
                    android:textSize="14sp" />

                <!-- Descrição -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Descrição"
                    android:textColor="@color/eq_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_busca"
                    android:gravity="top|start"
                    android:hint="O que essa equipe entrega e para quem?"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="200"
                    android:minHeight="96dp"
                    android:padding="14dp"
                    android:textColor="@color/eq_escuro"
                    android:textColorHint="@color/eq_texto_claro"
                    android:textSize="14sp" />

                <!-- Formato -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Formato"
                    android:textColor="@color/eq_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Chips (criados pelo Java) -->
                <LinearLayout
                    android:id="@+id/listaFormato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <!-- Tags -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tags"
                    android:textColor="@color/eq_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTags"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_busca"
                    android:hint="Separadas por vírgula, até 4"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/eq_escuro"
                    android:textColorHint="@color/eq_texto_claro"
                    android:textSize="14sp" />

                <!-- Ícone -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Ícone"
                    android:textColor="@color/eq_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Ícones (criados pelo Java) -->
                <GridLayout
                    android:id="@+id/gridIcones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="3" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEnviar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_botao_escuro"
                    android:text="Enviar proposta"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/menu_lateral"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>
