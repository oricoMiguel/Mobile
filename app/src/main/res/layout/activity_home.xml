<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conteudoPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_fundo">

        <!-- Barra do topo -->
        <LinearLayout
            android:id="@+id/barraTopo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_barra_home"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SERV+"
                android:textColor="@color/branco"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnNotificacoes"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Notificações"
                android:padding="6dp"
                android:src="@drawable/ic_bell" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Menu"
                android:padding="6dp"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <!-- Conteúdo rolável -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barraTopo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tag -->
                <TextView
                    android:id="@+id/tagSkillPods"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_home"
                    android:drawableStart="@drawable/ic_pods"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Equipes modulares"
                    android:textColor="@color/texto_lilas"
                    android:textSize="12sp" />

                <!-- Título -->
                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Monte sua equipe ideal com skill pods"
                    android:textColor="@color/branco"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Combine especialistas em blocos prontos e comece seu projeto em minutos."
                    android:textColor="@color/texto_lilas"
                    android:textSize="15sp" />

                <!-- Botões -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMonteEquipe"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_botao_branco"
                    android:drawableEnd="@drawable/ic_arrow_right_dark"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="24dp"
                    android:text="Montar minha equipe"
                    android:textAllCaps="false"
                    android:textColor="@color/preto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVerSkillPods"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_botao_outline_home"
                    android:text="Ver skill pods"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Skill pods populares -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Skill pods populares"
                        android:textColor="@color/branco"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVerTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Ver todos"
                        android:textColor="@color/texto_lilas"
                        android:textSize="13sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <!-- Os cards são criados pelo Java (item_skill_pod_popular) -->
                    <LinearLayout
                        android:id="@+id/listaPodsPopulares"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Conheça a SERV+ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Conheça a SERV+"
                    android:textColor="@color/branco"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Wrapper que dá a proporção 16:9 ao vídeo -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <FrameLayout
                        android:id="@+id/containerVideo"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_card_video"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="16:9"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <VideoView
                            android:id="@+id/videoEmpresa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menu lateral (abre pela direita) -->
    <include
        layout="@layout/menu_lateral"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>