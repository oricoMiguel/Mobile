<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/conteudoPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_fundo"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_barra_escura"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Voltar"
            android:padding="6dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="SERV+"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Revise sua equipe"
        android:textColor="@color/eq_escuro"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_opcao"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formato"
            android:textColor="@color/eq_texto_claro"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eq_escuro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Skill pod"
            android:textColor="@color/eq_texto_claro"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtPodNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eq_escuro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPodDescricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eq_texto_claro"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tamanho da equipe"
            android:textColor="@color/eq_texto_claro"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtPessoas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/eq_escuro"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_botao_escuro"
        android:text="Confirmar equipe"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>