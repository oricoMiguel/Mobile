<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conteudoPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eq_fundo">

        <!-- Barra do topo -->
        <LinearLayout
            android:id="@+id/barraTopo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_barra_escura"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnVoltar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Voltar"
                android:padding="6dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="SERV+"
                android:textColor="@color/branco"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Menu"
                android:padding="6dp"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <!-- Conteúdo rolável -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barraTopo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monte sua equipe"
                    android:textColor="@color/eq_escuro"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Escolha o formato e os skill pods do seu projeto."
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="14sp" />

                <!-- Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/circ1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_circulo_inativo"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/eq_texto_claro"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Formato"
                        android:textColor="@color/eq_escuro"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:background="@color/eq_borda" />

                    <TextView
                        android:id="@+id/circ2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_circulo_inativo"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/eq_texto_claro"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Pods"
                        android:textColor="@color/eq_escuro"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="8dp"
                        android:layout_weight="1"
                        android:background="@color/eq_borda" />

                    <TextView
                        android:id="@+id/circ3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_circulo_inativo"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/eq_texto_claro"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Revisão"
                        android:textColor="@color/eq_texto_claro"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Como você quer trabalhar?"
                    android:textColor="@color/eq_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Formato: Freelancers / Skill pods -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardFreelancers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_opcao"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Freelancers"
                                android:src="@drawable/ic_person"
                                android:tint="@color/eq_texto_claro" />

                            <ImageView
                                android:id="@+id/checkFreelancers"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="end"
                                android:contentDescription="Selecionado"
                                android:src="@drawable/ic_radio_on"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Freelancers"
                            android:textColor="@color/eq_escuro"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profissionais individuais"
                            android:textColor="@color/eq_texto_claro"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardSkillPods"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_opcao"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Skill pods"
                                android:src="@drawable/ic_pods"
                                android:tint="@color/eq_escuro" />

                            <ImageView
                                android:id="@+id/checkSkillPods"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="end"
                                android:contentDescription="Selecionado"
                                android:src="@drawable/ic_radio_on"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Skill pods"
                            android:textColor="@color/eq_escuro"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Equipes de 2 a 4"
                            android:textColor="@color/eq_texto_claro"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Seção de pods (aparece ao escolher Skill pods) -->
                <LinearLayout
                    android:id="@+id/secaoPods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_segmento_container"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tabDigitais"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segmento_ativo"
                            android:gravity="center"
                            android:text="Digitais"
                            android:textColor="@color/branco"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tabPresenciais"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Presenciais"
                            android:textColor="@color/eq_texto_claro"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Os pods são criados pelo Java (item_pod_opcao) -->
                    <LinearLayout
                        android:id="@+id/listaPods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Barra inferior com resumo e Continuar -->
        <LinearLayout
            android:id="@+id/barraInferior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sua equipe"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtResumo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nada selecionado"
                    android:textColor="@color/eq_escuro"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnContinuar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_botao_escuro"
                android:paddingHorizontal="24dp"
                android:text="Continuar  →"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menu lateral (abre pela direita) -->
    <include
        layout="@layout/menu_lateral"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>