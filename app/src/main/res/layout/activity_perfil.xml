<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/conteudoPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eq_fundo"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Cabeçalho -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:background="@drawable/bg_perfil_header"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/btnVoltar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Voltar"
                        android:padding="6dp"
                        android:src="@drawable/ic_back" />

                </LinearLayout>

                <!-- Foto de perfil -->
                <FrameLayout
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-62dp">

                    <TextView
                        android:id="@+id/txtIniciais"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_avatar_perfil"
                        android:gravity="center"
                        android:textColor="@color/roxo_icone"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgFotoPerfil"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="Foto de perfil"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <FrameLayout
                        android:id="@+id/badgeVerificado"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_badge_verificado"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="Verificado"
                            android:src="@drawable/ic_check_white" />

                    </FrameLayout>

                </FrameLayout>

                <!-- Nome -->
                <TextView
                    android:id="@+id/txtNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/eq_escuro"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <!-- Tipo de conta -->
                <TextView
                    android:id="@+id/txtTipoConta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/roxo_icone"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- E-mail -->
                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="14sp" />

                <!-- Informações complementares -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tituloInformacoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Informações"
                        android:textColor="@color/eq_escuro"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Telefone -->
                    <TextView
                        android:id="@+id/txtTelefonePerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_card_opcao"
                        android:padding="16dp"
                        android:textColor="@color/eq_escuro"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:visibility="gone" />

                    <!-- Organização -->
                    <TextView
                        android:id="@+id/txtEmpresaPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_card_opcao"
                        android:padding="16dp"
                        android:textColor="@color/eq_escuro"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:visibility="gone" />

                    <!-- Localização -->
                    <TextView
                        android:id="@+id/txtLocalizacaoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_opcao"
                        android:padding="16dp"
                        android:textColor="@color/eq_escuro"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Opções do próprio perfil -->
                <LinearLayout
                    android:id="@+id/listaOpcoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="12dp" />

            </LinearLayout>

        </ScrollView>

        <!-- Botão sair -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Sair"
                android:src="@drawable/ic_logout" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Sair"
                android:textColor="@color/eq_texto_claro"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
