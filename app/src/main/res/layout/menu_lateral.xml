<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barra_topo"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="72dp"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/menuInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Início"
        android:textColor="@color/branco"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/menuServicos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Serviços"
        android:textColor="@color/branco"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/menuSkillPods"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Skill Pods"
        android:textColor="@color/branco"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/menuAdm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="ADM"
        android:textColor="@color/branco"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/menuMonteEquipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Monte sua Equipe"
        android:textColor="@color/branco"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/menuPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Perfil"
        android:textColor="@color/branco"
        android:textSize="20sp" />
</LinearLayout>