<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barra_topo"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="72dp"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/menuInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Início"
        android:textColor="@color/branco"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/menuServicos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Serviços"
        android:textColor="@color/branco"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/menuSkillPods"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Skill Pods"
        android:textColor="@color/branco"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/menuAdm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="ADM"
        android:textColor="@color/branco"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/menuMonteEquipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Monte sua Equipe"
        android:textColor="@color/branco"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/menuEntrar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_botao"
        android:text="Entrar"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/menuCadastrar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_botao"
        android:text="Cadastrar-se"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="16sp" />
</LinearLayout>