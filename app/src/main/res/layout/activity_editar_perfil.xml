<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eq_fundo">

    <LinearLayout
        android:id="@+id/barraTopo"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_barra_escura"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Voltar"
            android:padding="6dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="SERV+"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraTopo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editar perfil"
                android:textColor="@color/eq_escuro"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Nome (todos os usuários) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nome"
                android:textColor="@color/eq_texto_claro"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_campo_login">

                <EditText
                    android:id="@+id/edtNome"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="center_vertical|start"
                    android:hint="Seu nome"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/preto"
                    android:textColorHint="@color/cinza_icone"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- Foto de perfil disponível para todos os tipos de conta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="84dp"
                        android:layout_height="84dp">

                        <TextView
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:background="@drawable/bg_avatar_roxo"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/roxo_icone"
                            android:textSize="30sp" />

                        <ImageView
                            android:id="@+id/imgFotoPerfil"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:contentDescription="Foto de perfil"
                            android:scaleType="centerCrop" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Foto de perfil"
                            android:textColor="@color/eq_escuro"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sua foto aparece no seu perfil. Para freelancers, também aparece em Serviços."
                            android:textColor="@color/eq_texto_claro"
                            android:textSize="12sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnEscolherFoto"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_botao_escuro"
                            android:paddingHorizontal="14dp"
                            android:text="Escolher foto"
                            android:textAllCaps="false"
                            android:textColor="@color/branco"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>


            <!-- Campos específicos da conta de usuário/contratante -->
            <LinearLayout
                android:id="@+id/secaoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Telefone (opcional)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">
                    <EditText
                        android:id="@+id/edtTelefoneUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: (11) 99999-9999"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Empresa ou organização (opcional)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">
                    <EditText
                        android:id="@+id/edtEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Nome da empresa ou organização"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Cidade (opcional)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">
                    <EditText
                        android:id="@+id/edtCidade"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: Mauá"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Estado (opcional)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">
                    <EditText
                        android:id="@+id/edtEstado"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: São Paulo ou SP"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Só aparece para quem é freelancer -->
            <LinearLayout
                android:id="@+id/secaoProfissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Perfil profissional"
                    android:textColor="@color/eq_escuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Área de atuação"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">

                    <EditText
                        android:id="@+id/edtArea"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: Desenvolvedora front-end"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Categoria"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">

                    <Spinner
                        android:id="@+id/spinnerCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="8dp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Habilidades (separe por vírgula)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">

                    <EditText
                        android:id="@+id/edtHabilidades"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: React, JavaScript, CSS"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDisponivel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Estou disponível para novos projetos"
                    android:textColor="@color/eq_escuro"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Texto de disponibilidade (opcional)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">

                    <EditText
                        android:id="@+id/edtDisponibilidade"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: Livre a partir de segunda"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Formas de contato (opcional)"
                    android:textColor="@color/eq_escuro"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Preencha somente os contatos que deseja exibir no seu perfil público."
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="WhatsApp (com DDD)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">
                    <EditText
                        android:id="@+id/edtWhatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: 5511999999999"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Instagram (usuário ou link)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">
                    <EditText
                        android:id="@+id/edtInstagram"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: @meuperfil"
                        android:inputType="textUri"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Telefone (opcional)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">
                    <EditText
                        android:id="@+id/edtTelefone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: (11) 3333-3333"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="E-mail para contato (opcional)"
                    android:textColor="@color/eq_texto_claro"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_login">
                    <EditText
                        android:id="@+id/edtEmailContato"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="center_vertical|start"
                        android:hint="Ex.: contato@exemplo.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/preto"
                        android:textColorHint="@color/cinza_icone"
                        android:textSize="16sp" />
                </FrameLayout>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_botao"
                android:stateListAnimator="@null"
                android:text="SALVAR"
                android:textColor="@color/branco"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>