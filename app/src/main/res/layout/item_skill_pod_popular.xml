<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_card_pod"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/iconeContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icone_roxo">

        <ImageView
            android:id="@+id/imgIcone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Ícone do skill pod" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Nome do pod"
        android:textColor="@color/preto"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtQuantidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 especialistas"
        android:textColor="@color/cinza_texto"
        android:textSize="12sp" />
</LinearLayout>